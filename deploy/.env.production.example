# Template for /opt/issuematcher/.env on the server. Fill in by hand there; never commit real values.
#   install -m 600 /dev/null /opt/issuematcher/.env && nano /opt/issuematcher/.env

POSTGRES_USER=issuematcher
# openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=issuematcher
# Same password as above. "db" is the Compose service name on the internal network.
DATABASE_URL=postgresql://issuematcher:<POSTGRES_PASSWORD>@db:5432/issuematcher

# Fine-grained PAT: public repositories, read-only. Used by the daily ingest.
GITHUB_TOKEN=

# Production GitHub OAuth App.
#   Homepage URL: https://issuematcher.duckdns.org
#   Callback URL: https://issuematcher.duckdns.org/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# openssl rand -hex 32
SESSION_SECRET=
CLIENT_URL=https://issuematcher.duckdns.org
