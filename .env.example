POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=github_issue_matcher
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/github_issue_matcher

# Personal access token (no scopes needed for public search). Raises search limit from 10 to 30 req/min.
GITHUB_TOKEN=

# GitHub OAuth App (Settings -> Developer settings -> OAuth Apps -> New).
# Authorization callback URL: http://localhost:5173/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Signs session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Where the browser app is served; OAuth redirects back here.
CLIENT_URL=http://localhost:5173
